# SevaSetu AI — Environment Variables
# Author: Rahul Jha | Made in India 🇮🇳
# Copy this to .env and fill in your values

APP_NAME=SevaSetu AI
DEBUG=false
LOG_LEVEL=INFO

# Security (CHANGE IN PRODUCTION!)
SECRET_KEY=sevasetu-secret-key-change-in-production-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=mysql+asyncmy://sevasetu:password@localhost:3306/sevasetu_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379

# AI APIs
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-key-here-optional
AI_MODEL=gemini-3.7-flash
AI_MAX_TOKENS=2048

# ChromaDB
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION=sevasetu_schemes
EMBEDDING_MODEL=all-MiniLM-L6-v2

# OCR
TESSERACT_CMD=/usr/bin/tesseract
TESSERACT_LANG=eng+hin+mar
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Email (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@sevasetu.ai
FROM_NAME=SevaSetu AI 🇮🇳

# Frontend URL used in password reset emails
FRONTEND_URL=https://sevasetu-ai-web.onrender.com

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","https://sevasetu-ai-web.onrender.com"]
